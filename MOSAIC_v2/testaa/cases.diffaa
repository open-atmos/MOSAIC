# junkdiffcase

set base_dir = $cwd

#set this_dir = '/files0/d37080/mosaic_box/mos41b_re7'
 set this_dir = $cwd

#set otherdir = '/files0/d37080/mosaic_box/mos41c_re1/testaa/cases.sv27'
#set otherdir = '/lustre/backedup/d37080/mosaic_box/fairf/mos41c_re3/testaa/cases.sv27'
 set otherdir = '/lustre/backedup/d37080/mosaic_box/fairf/mos41c_re3/testaa/cases.sv28'

set iflagaa = 1

set show_diffs_optaa = 1

echo ' '
echo 'comparing output files in'
echo '    this_dir =' $this_dir
if (! -e $this_dir) then
    echo '*** this_dir is not a directory ***'
    exit
endif
echo '    otherdir =' $otherdir
if (! -e $otherdir) then
    echo '*** otherdir is not a directory ***'
    exit
endif
echo ' '



#------------------------------------------------------------

if ($iflagaa == 1 || $iflagaa == 3) then

cd $this_dir

foreach fname (  \
case10.fullout.txt  \
case11.fullout.txt  \
case12.fullout.txt  \
case13.fullout.txt  \
case14.fullout.txt  \
case1.fullout.txt  \
case2.fullout.txt  \
case3.fullout.txt  \
case4.fullout.txt  \
case5.fullout.txt  \
case6.fullout.txt  \
case7.fullout.txt  \
case8.fullout.txt  \
case9.fullout.txt  \
wet2jd.fullout.txt \
wet2je.fullout.txt \
)

if ( -e $this_dir/$fname  &&  -e $otherdir/$fname ) then
    diff  $this_dir/$fname  $otherdir/$fname  >  /dev/null
    if ($status == 0) then
        echo '           match ' $fname
    else
        echo '      **** DIFFS ' $fname
        if ($show_diffs_optaa == 1) then
           diff  $this_dir/$fname  $otherdir/$fname  |  wc
        else if ($show_diffs_optaa == 2) then
           diff  $this_dir/$fname  $otherdir/$fname  |  wc
           diff  $this_dir/$fname  $otherdir/$fname
        endif
    endif
else if ( -e $this_dir/$fname ) then
    echo 'missing otherdir ' $fname
else if ( -e $otherdir/$fname ) then
    echo 'missing this_dir ' $fname
else
    echo 'missing both_dir ' $fname
endif

end


cd $base_dir

endif
echo ' '


#------------------------------------------------------------

if ($iflagaa == 2 || $iflagaa == 3) then

cd $otherdir

foreach fname (  \
aerosol/*.f90  \
cloud/*.f90  \
datamodules/*.f90  \
gas/*.f90  \
main/*.f90  \
solver/*.f90  \
)

if ( -e $this_dir/$fname  &&  -e $otherdir/$fname ) then
    diff  $this_dir/$fname  $otherdir/$fname  >  /dev/null
    if ($status == 0) then
        echo '           match ' $fname
    else
        echo '      **** DIFFS ' $fname
    endif
else if ( -e $this_dir/$fname ) then
    echo 'missing otherdir ' $fname
else if ( -e $otherdir/$fname ) then
    echo 'missing this_dir ' $fname
else
    echo 'missing both_dir ' $fname
endif

end


cd $base_dir

endif

echo ' '

#------------------------------------------------------------
