# sectwd.save
set verbose

ls -d sectwd.sv*

echo "Enter save directory name:"
set savedir = $<

mkdir $savedir

/bin/cp -p sectw?.inp sectw??.inp sectd?.inp sectd??.inp $savedir

/bin/cp -p sectw?.fullout.txt sectw??.fullout.txt sectd?.fullout.txt sectd??.fullout.txt $savedir

/bin/cp -p fort.172w? fort.172w?? fort.172d? fort.172d?? $savedir

ls -R $savedir

unset verbose



exit

sectd2.inp
sectd3.inp
