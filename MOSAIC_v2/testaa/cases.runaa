#!/bin/csh

foreach casename ( \
case1 \
case2 \
case3 \
case4 \
case5 \
case6 \
case7 \
case8 \
case9 \
case10 \
case11 \
case12 \
case13 \
case14 \
wet2jd \
wet2je \
)

set fname = {$casename}.fullout.txt
#echo "fname =" $fname
if ( -e $fname ) then
   /bin/rm $fname
else
   set fname = output/{$casename}.fullout.txt
#  echo "fname =" $fname
   if ( -e $fname ) then
      /bin/rm $fname
   endif
endif

echo "mosaic.x << eoi"  >! junkrunall_1case
set fname = {$casename}.inp
echo $fname             >> junkrunall_1case
echo "eoi"              >> junkrunall_1case

source  junkrunall_1case

/bin/rm junkrunall_1case

end


exit



