# gg05.diffaa

set base_dir = $cwd

#set this_dir = '/files0/d37080/mosaic_box/mos41b_re7'
 set this_dir = $cwd

#set otherdir = '/files0/d37080/mosaic_box/mos41a_re9/gg05.sv04'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re1/gg05.sv07'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re1/gg05.sv08'
#set otherdir = '/files0/d37080/mosaic_box/mos41a_re9'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re3/gg05.sv21'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re6/gg05.sv23'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re7/gg05.sv24'
#set otherdir = '/files0/d37080/mosaic_box/mos41b_re8/testaa/gg05.sv25'
#set otherdir = '/files0/d37080/mosaic_box/mos41c_re1/testaa/gg05.sv27'
 set otherdir = '/lustre/backedup/d37080/mosaic_box/fairf/mos41c_re3/testaa/gg05.sv27'

set iflagaa = 1

set show_diffs_optaa = 1


echo ' '
echo 'comparing output files in'
echo '    this_dir =' $this_dir
if (! -e $this_dir) then
    echo '*** this_dir is not a directory ***'
    exit
endif
echo '    otherdir =' $otherdir
if (! -e $otherdir) then
    echo '*** otherdir is not a directory ***'
    exit
endif
echo ' '



#------------------------------------------------------------

if ($iflagaa == 1 || $iflagaa == 3) then

cd $this_dir

foreach fname (  \
gg05aa.bm183  \
gg05aa.bm184  \
gg05aa.bm185  \
gg05aa.bm188  \
gg05aa.bm190  \
gg05aa.inp    \
gg05bb.bm183  \
gg05bb.bm184  \
gg05bb.bm185  \
gg05bb.bm188  \
gg05bb.bm190  \
gg05bb.inp    \
gg05dd.bm183  \
gg05dd.bm184  \
gg05dd.bm185  \
gg05dd.bm188  \
gg05dd.bm190  \
gg05dd.inp    \
gg05aa.fullout.txt    \
gg05bb.fullout.txt    \
gg05dd.fullout.txt    \
)

if ( -e $this_dir/$fname  &&  -e $otherdir/$fname ) then
    diff  $this_dir/$fname  $otherdir/$fname  >  /dev/null
    if ($status == 0) then
        echo '           match ' $fname
    else
        echo '      **** DIFFS ' $fname
        if ($show_diffs_optaa == 1) then
           diff  $this_dir/$fname  $otherdir/$fname  |  wc
        else if ($show_diffs_optaa == 2) then
           diff  $this_dir/$fname  $otherdir/$fname  |  wc
           diff  $this_dir/$fname  $otherdir/$fname
        endif
    endif
else if ( -e $this_dir/$fname ) then
    echo 'missing otherdir ' $fname
else if ( -e $otherdir/$fname ) then
    echo 'missing this_dir ' $fname
else
    echo 'missing both_dir ' $fname
endif

end


cd $base_dir

endif
echo ' '


#------------------------------------------------------------

if ($iflagaa == 2 || $iflagaa == 3) then

cd $otherdir

foreach fname (  \
gg04dd.bm183  \
gg04dd.bm184  \
gg04dd.bm185  \
gg04dd.bm190  \
gg04dd.inp  \
)

if ( -e $this_dir/$fname  &&  -e $otherdir/$fname ) then
    diff  $this_dir/$fname  $otherdir/$fname  >  /dev/null
    if ($status == 0) then
        echo '           match ' $fname
    else
        echo '      **** DIFFS ' $fname
    endif
else if ( -e $this_dir/$fname ) then
    echo 'missing otherdir ' $fname
else if ( -e $otherdir/$fname ) then
    echo 'missing this_dir ' $fname
else
    echo 'missing both_dir ' $fname
endif

end


cd $base_dir

endif

echo ' '

#------------------------------------------------------------
